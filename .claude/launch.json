{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "releve-next/apps/web", "run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "streamlit",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "app/main.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501,
      "autoPort": false
    }
  ]
}
